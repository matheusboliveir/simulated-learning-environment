
# Provider
LLM_PROVIDER=gemini

# Postgresql
POSTGRES_USER=sle_user
POSTGRES_PASSWORD=19042025
POSTGRES_DB=sle_database

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT=30

# Embedding
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
